# Copy to .env and adjust. NEVER commit the real .env file.

# Application
APP_NAME=Sistem Pendeteksi Pesan Penipuan Online
# development | test | production
ENVIRONMENT=development

# Security - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app refuses to start if this is left at the default value.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Comma-separated list of allowed frontend origins.
# Must not contain '*' when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Model artifacts (written by `python ml/train_model.py` from the repo root)
ML_MODEL_DIR=../ml
ML_MODEL_FILE=model.joblib
ML_VECTORIZER_FILE=vectorizer.joblib
ML_METADATA_FILE=metadata.json

# Database (used from Phase 5 onwards)
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/penipuan
DATABASE_URL=sqlite:///./dev.db
